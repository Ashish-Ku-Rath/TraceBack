# ==============================================================================
# TraceBack Environment Configuration Template
# Copy this file to .env and configure your actual parameters.
# Never commit the .env file containing secret credentials.
# ==============================================================================

# Execution Provider: "mock" (default, simulated execution) or "onlinecompiler"
EXECUTION_PROVIDER=mock

# Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./database/traceback.db

# OnlineCompiler Remote Execution API Configuration
ONLINECOMPILER_API_URL=https://api.onlinecompiler.io
ONLINECOMPILER_API_KEY=your_onlinecompiler_api_key_here
ONLINECOMPILER_PYTHON_COMPILER=python-3.14
ONLINECOMPILER_MAX_TESTS_PER_REQUEST=8
ONLINECOMPILER_DEFAULT_TIME_LIMIT=5

# Google Gemini API configuration for AI-powered code analysis
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=30
